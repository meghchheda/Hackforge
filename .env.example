# Copy to .env and adjust. .env is git-ignored; never commit secrets.

# --- server ---
# RJ_HOST=127.0.0.1
# RJ_PORT=8000
# RJ_DATA_DIR=data
# Set to 1 when the app is served over HTTPS (secure cookies + HSTS)
RJ_SECURE_COOKIES=0
# Landing page may show headline numbers and the assistant without sign-in. Use 0 with real data.
RJ_PUBLIC_DEMO=1
# Shows the audit-chain tamper-test button. Use 0 in production.
RJ_DEMO_TOOLS=1
RJ_SESSION_HOURS=12
RJ_LOG_LEVEL=INFO

# --- live data ---
RJ_RETRAIN_EVERY_HOURS=24
# Wall-clock seconds per data hour for the stale-feed check (3600 for real feeds; smaller for a sped-up demo feed)
RJ_LIVE_SECONDS_PER_HOUR=3600

# --- optional Claude copilot (needs account credits) ---
ANTHROPIC_API_KEY=
ENABLE_CLAUDE_COPILOT=0
